{
  "name": "bb-plugin-session-log",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Session Log",
    "description": "Shows everything a thread's agent did as one flat, live, searchable log in the thread's side panel: messages, thinking, commands with output and exit codes, tool calls, diffs and subagents.",
    "branding": {
      "icon": "./icons/logs.svg",
      "experimental_icons": {
        "logs": "./icons/logs.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hono": "^4.13.13",
    "jsdom": "^27.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
