{
  "name": "bb-plugin-forage",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.6.79"
  },
  "bb": {
    "name": "Forage",
    "description": "Six web-research tools for every BB agent: search, fetch, map, deterministic extraction, bounded crawl jobs and snapshot diffs, with a Research tab in every thread for what was looked up, kept pages, citations and crawls. A zero-turn CLI and privacy ceilings share one runtime.",
    "branding": {
      "icon": "./icons/forage.svg",
      "experimental_icons": {
        "forage": "./icons/forage.svg",
        "search": "./icons/search.svg",
        "fetch": "./icons/fetch.svg",
        "map": "./icons/map.svg",
        "extract": "./icons/extract.svg",
        "crawl": "./icons/crawl.svg",
        "diff": "./icons/diff.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build",
    "pretest": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "5.5.0",
    "hono": "^4.13.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
