{
  "name": "bb-plugin-gruve",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.6.79"
  },
  "bb": {
    "name": "Gruve",
    "description": "A coding theme with gruvbox and House style palettes, flat surfaces, configurable fonts and a terminal-style composer.",
    "branding": {
      "icon": "./icons/gruve.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "themes": [
      {
        "id": "gruve",
        "name": "Gruve",
        "description": "Gruvbox or House style in light and dark, with configurable accents, fonts, corners and a terminal-style composer.",
        "css": "./themes/gruve.css",
        "codeTheme": {
          "dark": "gruvbox-dark-soft",
          "light": "gruvbox-light-hard"
        }
      }
    ]
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "hono": "^4.13.13",
    "jsdom": "^27.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
