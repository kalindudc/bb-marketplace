{
  "name": "bb-plugin-flare",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Flare",
    "description": "Lets agents send up a flare mid-turn: a finding, a decision, progress or a blocker you see at once in a banner above the message box and in the thread's Flares tab, with a push notification for blockers. The flare tool returns at once and never holds the agent's turn.",
    "branding": {
      "icon": "./icons/flare.svg",
      "experimental_icons": {
        "flare": "./icons/flare.svg",
        "finding": "./icons/finding.svg",
        "progress": "./icons/progress.svg",
        "decision": "./icons/decision.svg",
        "blocker": "./icons/blocker.svg",
        "summary": "./icons/summary.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills"
    ],
    "host": "./host.ts"
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "zod": "4.6.6",
    "@get-bb/plugin-sdk": "0.6.104"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^27.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
