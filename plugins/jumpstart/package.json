{
  "name": "bb-plugin-jumpstart",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Jumpstart",
    "description": "Resume the threads a network blip stopped. A button in the sidebar footer lists every failed thread with the error that stopped it, ticks the ones that failed on a connection or timeout error, and retries the ticked ones in one click. `bb jumpstart` does the same from a terminal.",
    "branding": {
      "icon": "RotateCcw"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^27.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
