{
  "name": "bb-plugin-press",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Press",
    "description": "A compaction governor for bb threads: it decides when a thread should compact from a policy of compaction points and vetoes, compacts between turns (holding the next message while it does), and records every decision and compaction. It never writes summaries; the Press composer extension does that.",
    "branding": {
      "icon": "./icons/press.svg",
      "experimental_icons": {
        "press": "./icons/press.svg"
      }
    },
    "server": "./server.ts",
    "skills": [
      "./skills"
    ],
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.13.20",
    "jsdom": "^27.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
