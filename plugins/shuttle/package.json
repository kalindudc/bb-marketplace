{
  "name": "bb-plugin-shuttle",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Shuttle",
    "description": "Every pull request that needs you, from any server, in one place. An Inbox of the decisions waiting on you, your own PRs with the agent thread that fixes their reviews and failed checks, a review centre for the PRs that ask you or your teams, and insights into where your time goes. Merge, comment, reply and post AI review drafts from Shuttle, on GitHub, Delta or any server you add with a few commands.",
    "branding": {
      "icon": "./icons/shuttle.svg",
      "experimental_icons": {
        "shuttle": "./icons/shuttle.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.75",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "jsdom": "^27.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
